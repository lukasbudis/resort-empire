        </mxCell>
        <mxCell id="v8t9KGp93ofDw4pH66zE-18" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;&quot;&gt;FR-16 - Obsadenie budov&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Viditelne na mape, S2 aj S3.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Po presune sa vsade aktualizuje naraz.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Budova je obsadena alebo prazdna.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="285" x="505" y="70" as="geometry" />
        </mxCell>
        <mxCell id="v8t9KGp93ofDw4pH66zE-35" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="250" width="330" x="470" y="230" as="geometry" />
        </mxCell>
        <mxCell id="v8t9KGp93ofDw4pH66zE-23" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b style=&quot;&quot;&gt;FR-37 - Vstup a odozva S2&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Kliknutie na need otvori S3 pre budovu, ktora ho obsluhuje.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Ak uz budova ma workera, presun do nej sa neponuka.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Na S2 aj bez otvorenia S3:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;BOTTLENECK: budova nestiha obsluhu a tvori sa rad cakajucich hosti. Hra ju zvyrazni a zobrazi hlasku.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;RECOVERING: situacia sa zlepsuje a rad cakajucich hosti sa skracuje. Hra to oznami pozitivnou hlaskou.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="310" x="480" y="250" as="geometry" />
        </mxCell>
        <mxCell id="v8t9KGp93ofDw4pH66zE-37" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="240" width="330" x="470" y="500" as="geometry" />
        </mxCell>
        <mxCell id="v8t9KGp93ofDw4pH66zE-24" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Pravidla presunu&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;FR-11: presun je zadarmo.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;FR-14: pred vlnou, pocas prichodu aj dobehu; rozmiestnenie zostava zachovane medzi vlnami.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;FR-13: bez workera je vykon nizsi, ale &amp;gt; 0 (nastavitelny, bezne 0,33).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;FR-15: vykon oboch budov sa zmeni hned, aj pre uz sediacich hosti.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Po presune je vidiet, ze v povodnej budove uz nie je worker.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="320" x="475" y="530" as="geometry" />
        </mxCell>
      </root>
